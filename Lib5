        local function getParentForElement()
            if Scroll:FindFirstChild("ColumnA") and Scroll:FindFirstChild("ColumnB") then
                local a = Scroll.ColumnA
                local b = Scroll.ColumnB
                local la = a:FindFirstChildOfClass("UIListLayout")
                local lb = b:FindFirstChildOfClass("UIListLayout")
                if la and lb then
                    if la.AbsoluteContentSize.Y <= lb.AbsoluteContentSize.Y then
                        return a
                    else
                        return b
                    end
                end
