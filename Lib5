                                            end
                                        end
                                        for _, el in ipairs(ColumnB and ColumnB:GetChildren() or {}) do
                                            if el:IsA("TextButton") or el:IsA("Frame") then
                                                table.insert(toMove, el)
                                            end
                                        end
                                        for _, el in ipairs(toMove) do
                                            el.Parent = scroll
                                        end
                                        ColumnA:Destroy()
                                        ColumnB:Destroy()
                                        -- Recria UIListLayout
                                        if not scroll:FindFirstChildOfClass("UIListLayout") then
                                            local PList = Instance.new("UIListLayout", scroll)
                                            PList.Padding = UDim.new(0, 8)
                                            PList.SortOrder = Enum.SortOrder.LayoutOrder
                                            PList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                                                scroll.CanvasSize = UDim2.new(0,0,0, PList.AbsoluteContentSize.Y + 10)
                                            end)
                                        end
                                        -- Ajusta CanvasSize
                                        local PList = scroll:FindFirstChildOfClass("UIListLayout")
                                        if PList then
                                            scroll.CanvasSize = UDim2.new(0,0,0, PList.AbsoluteContentSize.Y + 10)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
