            local V = Instance.new("TextLabel", S)
            V.Size = UDim2.new(0, 50, 0, 28)
            V.Position = UDim2.new(1, -60, 0, 2)
            V.BackgroundTransparency = 1
            V.Text = tostring(def)
            V.TextColor3 = Theme.Accent2
            V.Font = Theme.Font
            V.TextSize = 11
            V.TextXAlignment = Enum.TextXAlignment.Right
            local Bar = Instance.new("Frame", S)
            Bar.Size = UDim2.new(1, -24, 0, 6)
            Bar.Position = UDim2.new(0, 12, 1, -12)
            Bar.BackgroundColor3 = Theme.Main
            Bar.BorderSizePixel = 0
            CreateCorner(Bar, 3)
            local Fill = Instance.new("Frame", Bar)
            Fill.Size = UDim2.new((def-min)/(max-min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent1
            Fill.BorderSizePixel = 0
            CreateCorner(Fill, 3)
            local function Update(input)
                local per = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * per)
                Fill.Size = UDim2.new(per, 0, 1, 0)
                V.Text = tostring(val)
                callback(val)
            end
            local dragging = false
            Bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Update(i)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    Update(i)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        function Components:Dropdown(txt, list, callback)
            local parent = getParentForElement()
            local D = Instance.new("Frame", parent)
            D.Size = UDim2.new(1, -10, 0, 38)
            D.BackgroundColor3 = Theme.TopBar
            D.ClipsDescendants = true
            D.BorderSizePixel = 0
            CreateCorner(D, 8)
            CreateStroke(D)
            local DLbl = Instance.new("TextLabel", D)
            DLbl.Size = UDim2.new(1, -40, 0, 38)
            DLbl.Position = UDim2.new(0, 12, 0, 0)
            DLbl.BackgroundTransparency = 1
            DLbl.Text = txt .. " : ..."
            DLbl.TextColor3 = Theme.Text
            DLbl.Font = Theme.Font
            DLbl.TextSize = 11
            DLbl.TextXAlignment = Enum.TextXAlignment.Left
            local DBtn = Instance.new("TextButton", D)
            DBtn.Size = UDim2.new(1, 0, 0, 38)
            DBtn.BackgroundTransparency = 1
            DBtn.Text = ""
            DBtn.BorderSizePixel = 0
            local ContainerBox = Instance.new("Frame", D)
            ContainerBox.Position = UDim2.new(0, 5, 0, 40)
            ContainerBox.Size = UDim2.new(1, -10, 0, 0)
            ContainerBox.BackgroundTransparency = 1
            ContainerBox.BorderSizePixel = 0
            local L = Instance.new("UIListLayout", ContainerBox)
            L.Padding = UDim.new(0, 5)
            local open = false
            DBtn.MouseButton1Click:Connect(function()
                open = not open
                local targetH = 38
                if open then
                    targetH = L.AbsoluteContentSize.Y + 48
                end
                TweenService:Create(D, TweenInfo.new(0.3), {Size = UDim2.new(1, -10, 0, targetH)}):Play()
            end)
            for _, v in pairs(list or {}) do
                local Opt = Instance.new("TextButton", ContainerBox)
                Opt.Size = UDim2.new(1, 0, 0, 25)
                Opt.BackgroundColor3 = Theme.Main
                Opt.Text = v
                Opt.TextColor3 = Theme.TextDim
                Opt.Font = Theme.FontLight
                Opt.TextSize = 11
                Opt.BorderSizePixel = 0
                CreateCorner(Opt, 4)
                Opt.MouseButton1Click:Connect(function()
                    DLbl.Text = txt .. " : " .. v
                    open = false
                    callback(v)
                    TweenService:Create(D, TweenInfo.new(0.3), {Size = UDim2.new(1, -10, 0, 38)}):Play()
                end)
            end
        end

        function Components:Section(txt)
            local parent = getParentForElement()
            local S = Instance.new("TextLabel", parent)
            S.Size = UDim2.new(1, 0, 0, 25)
            S.BackgroundTransparency = 1
            S.Text = "» " .. txt:upper()
            S.TextColor3 = Theme.Accent1
            S.Font = Theme.Font
            S.TextSize = 10
            S.TextXAlignment = Enum.TextXAlignment.Left
        end

        table.insert(Window.Tabs, {Btn = TabBtn, Page = Page, Stroke = tStroke})
        if #Window.Tabs == 1 then
            Page.Visible = true
            Page.GroupTransparency = 0
            TabBtn.BackgroundColor3 = Theme.Accent1
            TabBtn.TextColor3 = Theme.Main
            tStroke.Color = Theme.Accent1
        end
        return Components
    end

    return Window
end

-- // Função para destruir a janela e limpar conexões
function Library:Destroy()
    if Root:FindFirstChild("FluxiomV7") then
        Root.FluxiomV7:Destroy()
    end
end

-- // Função para mudar o tema dinâmicamente
function Library:SetTheme(tbl)
    for k, v in pairs(tbl) do
        if Theme[k] ~= nil then
            Theme[k] = v
        end
    end
end

-- // Função utilitária para notificação simples
function Library:Notify(msg, duration)
    duration = duration or 2
    local gui = Instance.new("ScreenGui", Root)
    gui.Name = "FluxiomNotify"
    gui.ResetOnSpawn = false
    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 320, 0, 44)
    frame.Position = UDim2.new(0.5, -160, 0.1, 0)
    frame.BackgroundColor3 = Theme.TopBar
    frame.BorderSizePixel = 0
    frame.BackgroundTransparency = 0.1
    CreateCorner(frame, 10)
    CreateStroke(frame, Theme.Accent1, 2)
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = tostring(msg)
    label.TextColor3 = Theme.Text
    label.Font = Theme.Font
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    frame.GroupTransparency = 1
    TweenService:Create(frame, TweenInfo.new(0.25), {GroupTransparency = 0}):Play()
    task.delay(duration, function()
        TweenService:Create(frame, TweenInfo.new(0.25), {GroupTransparency = 1}):Play()
        task.wait(0.26)
        if gui and gui.Parent then
            gui:Destroy()
        end
    end)
end

-- // Função para checar se a janela está aberta
function Library:IsOpen()
    local gui = Root:FindFirstChild("FluxiomV7")
    if gui and gui:FindFirstChild("MainWindow") then
        return gui.MainWindow.Visible
    end
    return false
end

return Library
