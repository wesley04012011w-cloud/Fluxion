                                            ColumnA.Name = "ColumnA"
                                            ColumnA.BackgroundTransparency = 1
                                            ColumnA.Size = UDim2.new(0.5, -6, 1, 0)
                                            ColumnA.Position = UDim2.new(0, 0, 0, 0)
                                            local ColumnB = Instance.new("Frame", scroll)
                                            ColumnB.Name = "ColumnB"
                                            ColumnB.BackgroundTransparency = 1
                                            ColumnB.Size = UDim2.new(0.5, -6, 1, 0)
                                            ColumnB.Position = UDim2.new(0.5, 6, 0, 0)
                                            local ListA = Instance.new("UIListLayout", ColumnA)
                                            ListA.Padding = UDim.new(0, 6)
                                            ListA.SortOrder = Enum.SortOrder.LayoutOrder
                                            local ListB = Instance.new("UIListLayout", ColumnB)
                                            ListB.Padding = UDim.new(0, 6)
                                            ListB.SortOrder = Enum.SortOrder.LayoutOrder
                                            -- Move elementos alternadamente para as colunas
                                            local idx = 0
                                            local toMove = {}
                                            for _, el in ipairs(scroll and scroll:GetChildren() or {}) do
                                                if el:IsA("TextButton") or el:IsA("Frame") then
                                                    if el ~= ColumnA and el ~= ColumnB then
                                                        table.insert(toMove, el)
                                                    end
                                                end
                                            end
                                            for i, el in ipairs(toMove) do
                                                if i % 2 == 1 then
                                                    el.Parent = ColumnA
                                                else
                                                    el.Parent = ColumnB
                                                end
                                            end
                                            -- Remove o UIListLayout antigo do scroll
                                            for _, l in ipairs(scroll and scroll:GetChildren() or {}) do
                                                if l:IsA("UIListLayout") then
                                                    l:Destroy()
                                                end
                                            end
                                            -- Ajusta CanvasSize dinamicamente
                                            local function updateCanvas()
                                                local hA = ListA.AbsoluteContentSize.Y
                                                local hB = ListB.AbsoluteContentSize.Y
                                                scroll.CanvasSize = UDim2.new(0,0,0, math.max(hA, hB) + 10)
                                            end
                                            ListA:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
                                            ListB:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
                                            updateCanvas()
                                        end
                                    end
                                end
                            end
                        end
                    end
                else
                    TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.fromOffset(550, 350),
                        Position = UDim2.new(0.5, -275, 0.5, -175)
                    }):Play()
                    -- Volta para modo 1 coluna
                    for _, page in ipairs(Container:GetChildren()) do
                        if page:IsA("CanvasGroup") then
                            for _, scroll in ipairs(page:GetChildren()) do
                                if scroll:IsA("ScrollingFrame") then
                                    local ColumnA = scroll:FindFirstChild("ColumnA")
                                    local ColumnB = scroll:FindFirstChild("ColumnB")
                                    if ColumnA and ColumnB then
